{
  "name": "cannabiverse",
  "version": "0.3.0",
  "private": true,
  "description": "Governed, source-aware Cannabis phytochemistry knowledge graph",
  "type": "module",
  "scripts": {
    "build:evidence": "node scripts/build-evidence-graph.mjs",
    "check:evidence": "node scripts/build-evidence-graph.mjs --check",
    "validate": "node scripts/build-evidence-graph.mjs --check && node scripts/validate-atlas.mjs",
    "test": "npm run validate"
  }
}
