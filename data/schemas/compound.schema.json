{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/Cannabiverse/data/schemas/compound.schema.json",
  "title": "Cannabiverse canonical compound",
  "type": "object",
  "required": [
    "atlas_id", "canonical_name", "family", "canonical_status",
    "identity_level", "occurrence_level", "biosynthesis_level",
    "source_id", "source_year", "source_url"
  ],
  "properties": {
    "atlas_id": {"type":"string","pattern":"^CPA-CAN-[0-9]{4}$"},
    "legacy_id": {"type":"string"},
    "baseline_id": {"oneOf":[{"type":"integer","minimum":1},{"type":"string","maxLength":0}]},
    "canonical_name": {"type":"string","minLength":1},
    "short_label": {"type":"string"},
    "family": {"type":"string","minLength":1},
    "radwan_subclass": {"type":"string"},
    "form": {"type":"string"},
    "side_chain": {"type":"string"},
    "canonical_status": {"enum":["BASELINE_2021_LOCKED","POST_BASELINE_CONFIRMED"]},
    "identity_level": {"type":"string","pattern":"^I[0-4](?:_|$)"},
    "occurrence_level": {"type":"string","pattern":"^O[0-4](?:_|$)"},
    "biosynthesis_level": {"type":"string","pattern":"^B[0-3](?:_|$)"},
    "source_id": {"type":"string","minLength":1},
    "source_year": {"type":"integer","minimum":1900},
    "source_url": {"type":"string"},
    "curation_note": {"type":"string"},
    "occurrence_caution": {"type":"string"}
  },
  "additionalProperties": true
}
