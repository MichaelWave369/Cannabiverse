{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/Cannabiverse/data/schemas/claim.schema.json",
  "title": "Cannabiverse relationship claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim_type",
    "subject_id",
    "predicate",
    "object_id",
    "evidence_lane",
    "authority",
    "status",
    "source_ids",
    "derived_from_edge_id"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CPA-CLM-[0-9]{4}$"
    },
    "claim_type": {
      "const": "RELATIONSHIP_ASSERTION"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_lane": {
      "enum": [
        "biosynthesis",
        "transformation",
        "structure",
        "biosynthesis_hypothesis"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ASSERTED_WITH_SOURCE",
        "HYPOTHESIS"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-"
      }
    },
    "derived_from_edge_id": {
      "type": "string",
      "pattern": "^CPA-EDGE-[0-9]{4}$"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
