{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/Cannabiverse/data/schemas/source.schema.json",
  "title": "Cannabiverse source receipt",
  "type": "object",
  "required": [
    "source_id",
    "year",
    "authors",
    "title",
    "url",
    "use"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "authors": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "doi": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "use": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}