{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/Cannabiverse/data/schemas/compound-evidence-claim.schema.json",
  "title": "Cannabiverse compound evidence claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim_type",
    "subject_id",
    "predicate",
    "evidence_lane",
    "level",
    "status",
    "source_ids",
    "source_year",
    "source_url",
    "canonical_status",
    "note"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CPA-EVC-[0-9]{4}-(I|O)$"
    },
    "claim_type": {
      "const": "COMPOUND_EVIDENCE_STATE"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^CPA-CAN-[0-9]{4}$"
    },
    "predicate": {
      "enum": [
        "HAS_IDENTITY_EVIDENCE_LEVEL",
        "HAS_OCCURRENCE_EVIDENCE_LEVEL"
      ]
    },
    "evidence_lane": {
      "enum": [
        "identity",
        "occurrence"
      ]
    },
    "level": {
      "type": "string",
      "pattern": "^[IO][0-4](?:_|$)"
    },
    "status": {
      "enum": [
        "ASSERTED_WITH_SOURCE",
        "CAUTIONED"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-"
      }
    },
    "source_year": {
      "type": "integer",
      "minimum": 1900
    },
    "source_url": {
      "type": "string"
    },
    "canonical_status": {
      "enum": [
        "BASELINE_2021_LOCKED",
        "POST_BASELINE_CONFIRMED"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
